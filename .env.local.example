# Copy this file to .env.local and fill in the real values.
# .env.local is already gitignored by default in Next.js — never commit real secrets.

# The URL your app is running at. Locally: http://localhost:3000
# In production: your real Vercel URL, e.g. https://onboard-os.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Project Settings > API > Project API keys > anon public
# Safe to expose in the browser — RLS policies do the real access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings > API > Project API keys > service_role
# SECRET. Never prefix with NEXT_PUBLIC_. Never use in browser code.
# Bypasses Row-Level Security entirely — server-side use only.
SUPABASE_SERVICE_ROLE_KEY=

# Resend (resend.com) > API Keys > Create API Key
# Free tier: 3,000 emails/month. Used for magic links, nudges, notifications.
RESEND_API_KEY=

# Required for transactional email. Use a sender address from a domain verified
# in Resend (or Resend's permitted onboarding@resend.dev test sender during development).
RESEND_FROM_EMAIL=

# Optional: enables the AI review-summary feature on the review page.
# Google AI Studio > Get API Key. Checked before OPENAI_API_KEY. If neither
# this nor OPENAI_API_KEY is set, that feature simply doesn't run — no
# error, no fake data.
GEMINI_API_KEY=

# Optional: platform.openai.com > API Keys. Used as a fallback if
# GEMINI_API_KEY isn't set.
OPENAI_API_KEY=
